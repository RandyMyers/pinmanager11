NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGO_URL=mongodb://localhost:27017/pin_dashboard
# also accepted: MONGODB_URI

JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=30d

# 32-byte key, base64. Encrypts Pinterest tokens at rest.
TOKEN_ENC_KEY=

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:5000/api/accounts/callback
PINTEREST_ENV=sandbox
PINTEREST_STANDARD_APPROVED=false

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=
# also accepted: CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_SECRET
CLOUDINARY_FOLDER=pin-dashboard

DEFAULT_DAILY_CAP=15
DEFAULT_MIN_GAP_MINUTES=20
WORKER_TICK_SECONDS=30
